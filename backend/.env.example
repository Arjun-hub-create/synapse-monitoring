# FastAPI Settings
APP_NAME=Synapse
APP_VERSION=1.0.0
DEBUG=True
API_PREFIX=/api/v1

# MongoDB
MONGODB_URL=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/synapse?retryWrites=true&w=majority
DATABASE_NAME=synapse

# JWT
SECRET_KEY=your-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Health Check Scheduler
HEALTH_CHECK_INTERVAL_SECONDS=60

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=True
